{
    "layer": "top",
    "modules-left": ["custom/user"],
    "modules-center": ["sway/workspaces"],
    "modules-right": ["custom/clock"],
    "custom/user": {
        "icon": true,
        "exec": "echo 'VPN UI'",
        "interval": 1,
        "on-click": "globalprotect launch-ui"
    },
    "sway/workspaces": {
        "format": "{name}",
        "format": "{icon}",
        "tooltip": false,
        "all-outputs": true,
    },
    "custom/clock": {
        "exec": "date +'%H:%M'",
        "interval": 1,
        "tooltip": false,
    }
}
